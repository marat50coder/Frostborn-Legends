<?xml version="1.0" encoding="utf-8"?>
<!--
    Frostborn Legends — Android 12+ backup / device-transfer scope.

    We opt every persisted surface out of the auto-backup pipeline
    so a device migration never resurrects a stale WardenBell
    channel state or a half-consumed pending-push slot. Both
    domains are covered explicitly (the platform default is
    "include everything"), matching what the app already declares
    with android:allowBackup="false" in the manifest.
-->
<data-extraction-rules>

  <cloud-backup>
    <!-- Cloud restore: skip preferences + file storage. -->
    <exclude domain="sharedpref"/>
    <exclude domain="file"/>
    <exclude domain="database"/>
    <exclude domain="external"/>
  </cloud-backup>

  <device-transfer>
    <!-- Device-to-device transfer: identical exclusions. -->
    <exclude domain="sharedpref"/>
    <exclude domain="file"/>
    <exclude domain="database"/>
    <exclude domain="external"/>
  </device-transfer>

</data-extraction-rules>
