<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode twin of values-v31/styles.xml. The splash art is the same in
         both modes so the icon on the home screen and the splash always match. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_sky</item>
    </style>
</resources>
